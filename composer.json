{
    "name": "skeeks/cms-communication-imap",
    "description": "IMAP/SMTP mailbox driver for skeeks/cms-communication",
    "keywords": ["yii", "skeeks", "cms", "crm", "email", "imap", "smtp"],
    "homepage": "https://cms.skeeks.com/",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://skeeks.com/",
        "wiki": "https://cms.skeeks.com/docs/",
        "source": "https://github.com/skeeks-cms/cms-communication-imap"
    },
    "authors": [
        {
            "name": "Semenov Alexander",
            "email": "semenov@skeeks.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "skeeks/cms-communication": "^1.0",
        "symfony/mailer": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "skeeks\\cms\\communication\\imap\\": "src/"
        }
    },
    "extra": {
        "config-plugin": {
            "web": ["src/config/common.php"],
            "console": ["src/config/common.php"]
        }
    }
}
